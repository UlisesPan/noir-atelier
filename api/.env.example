NODE_ENV=development
PORT=3100
# Orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:3000

# Opción A: URL completa (Neon/Render). Si está presente, tiene prioridad.
DATABASE_URL=
DATABASE_SSL=false
# Opción B: variables sueltas (desarrollo local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=noir_atelier

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# URL pública del front (redirecciones de Mercado Pago)
FRONTEND_URL=http://localhost:3000
# URL pública de esta API (webhook de Mercado Pago). Vacío en local.
API_PUBLIC_URL=
# Access token de prueba de Mercado Pago (TEST-...). Vacío = modo pago simulado.
MP_ACCESS_TOKEN=

# Usuario admin creado por el seed
ADMIN_EMAIL=admin@noiratelier.dev
ADMIN_PASSWORD=

# Carga clientes, órdenes y reseñas de demostración (para el portfolio)
SEED_DEMO_DATA=false
